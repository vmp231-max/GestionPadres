# Configuración de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Configuración de Gemini API (Google AI Studio)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Configuración de Google Calendar (Cuenta de Servicio)
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-cuenta-de-servicio@proyecto.iam.gserviceaccount.com
# La clave privada debe incluir los saltos de línea \n y estar entre comillas
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# IDs de los Calendarios de Google
GOOGLE_CALENDAR_ID_MAMA=tu-madre-calendar-id@group.calendar.google.com
GOOGLE_CALENDAR_ID_PAPA=tu-padre-calendar-id@group.calendar.google.com

# Clave / PIN de acceso a la aplicación para la tablet
TABLET_PIN=1234
# Días de duración de la sesión antes de volver a solicitar la clave
TABLET_SESSION_DAYS=30
