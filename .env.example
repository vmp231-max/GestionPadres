# ==========================================
# GESTIÓN MÉDICA FAMILIAR - VARIABLES DE ENTORNO
# ==========================================

# 1. Configuración de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_opcional

# 2. Configuración de Gemini API (Google AI Studio - Procesamiento de recetas PDF)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# 3. Configuración de Google Calendar (Cuenta de Servicio para sincronización de citas)
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-cuenta-de-servicio@proyecto.iam.gserviceaccount.com
# La clave privada debe incluir los saltos de línea \n y estar entre comillas
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 4. Configuración Opcional
# Días de duración de la sesión antes de volver a solicitar la clave en la tablet (por defecto: 30)
TABLET_SESSION_DAYS=30
